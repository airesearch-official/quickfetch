{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickFetch",
  "version": "0.1.1",
  "identifier": "app.quickfetch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuickFetch",
        "width": 880,
        "height": 760,
        "minWidth": 680,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "QuickFetch",
    "shortDescription": "Fast, focused video downloads with yt-dlp",
    "longDescription": "A lightweight Windows desktop frontend for yt-dlp with a concurrent download queue.",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
